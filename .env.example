# ───────────── Majburiy ─────────────
# @BotFather dan olingan token
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Sizning Telegram ID (raqam). Bilmasangiz: botga /id yozing yoki @userinfobot
MY_ID=0
# Uning Telegram ID. 0 qoldirsangiz bot "setup rejimi"da ishlaydi:
# kim yozsa, o'z ID sini ko'radi. ID ni bilgach shu yerga yozib, qayta ishga tushiring.
HER_ID=0

MY_NAME=Bilol
HER_NAME=Aida

# Birga bo'lganingiz boshlangan sana (YYYY-MM-DD yoki YYYY-MM-DD HH:MM)
TOGETHER_SINCE=2026-03-26

# ───────────── Ixtiyoriy ─────────────
# Keyingi uchrashuv (countdown uchun). Bo'sh qoldirsa bo'ladi.
NEXT_DATE=
NEXT_DATE_TITLE=Keyingi uchrashuvimiz

TZ=Asia/Tashkent

# Kunlik "sabab" va kayfiyat so'rovi vaqti (24 soat)
REASON_TIME=08:30
MOOD_TIME=20:30

# Viktorina oxirida yuboriladigan joy (Google Maps dan koordinata)
GIFT_LAT=41.549340
GIFT_LON=70.027026
GIFT_TITLE=Balandda Chimgan 🏔 — sovg'ang shu yerda
GIFT_ADDRESS=Chimyon, Toshloqbet ko'chasi 159, Bo'stonliq tumani

# Ma'lumotlar bazasi fayli
DB_PATH=data/lovebot.db

# Soatlik sevgi xabarlari: har necha daqiqada (5,10,15,20,30,60,120,180,240) va qaysi vaqt oralig'ida
LOVE_INTERVAL_MINUTES=120
LOVE_WINDOW=09:00-23:00

# 30 kunlik kalendar xati har kuni shu vaqtda; viktorinada har o'yinda nechta savol
CALENDAR_TIME=09:00
QUIZ_PER_GAME=6

# 🎬 Kino kechasi (Mini App). Railway domeningiz — bo'sh bo'lsa kino o'chiq.
PUBLIC_URL=
# Veb-server porti (Railway o'zi PORT beradi — yozish shart emas)
PORT=8080
# Ixtiyoriy: o'z TURN serveringiz (bo'sh bo'lsa tekin Open Relay ishlatiladi)
TURN_URL=
TURN_USER=
TURN_PASS=
